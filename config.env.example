# ==============================================================================
# Backup Framework Configuration Template (Zero Secrets Standard)
# Copy this file to /etc/backup/config.env or /root/.backup_env with mode 0600
# ==============================================================================

# Restic Configuration
RESTIC_PASSWORD_FILE="/root/.resticpasswd"
RESTIC_REPOSITORY_FILE="/root/.resticrepo"

# Rclone Configuration
RCLONE_CONFIG="/root/.config/rclone/rclone.conf"

# Notification Configuration (Optional)
# Format: https://ntfy.example.com/<TOPIC_OR_TOKEN>
NTFY_URL="https://ntfy.example.com/<REDACTED_TOPIC_OR_TOKEN>"

# Webhook Notification (Optional, JSON payload)
# WEBHOOK_URL="https://discord.com/api/webhooks/<ID>/<TOKEN>"

# Dead-Man's Snitch / Healthcheck Ping (Optional)
# HEALTHCHECK_URL="https://hc-ping.com/<UUID>"

# Logging Configuration
LOG_LEVEL="INFO" # Options: DEBUG, INFO, WARN, ERROR
